# SendGrid (transactional email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Memory Block Vendor Checklist

# Comma-separated list of office addresses that get the new-vendor kickoff
# email and the weekly reminder emails
OFFICE_RECIPIENTS=yuvi@memoryblock.com.au,admin@memoryblock.com.au,lauren@memoryblock.com.au,love@memoryblock.com.au,info@memoryblock.com.au,shay@memoryblock.com.au,laki@memoryblock.com.au,hd@memoryblock.com.au

# Public URL of the deployed app, used to build links inside emails
APP_URL=http://localhost:5173

# Weekly reminder schedule (cron syntax) and timezone
REMINDER_CRON=0 8 * * 1
REMINDER_TIMEZONE=Australia/Sydney

# Where the SQLite file lives (set to a mounted volume path in production)
DATA_DIR=
PORT=3002
